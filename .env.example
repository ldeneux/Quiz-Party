# Copie ce fichier en .env.local et remplis avec les valeurs de ton projet Supabase
# (Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Clé API Gemini (ai.google.dev) — utilisée pour générer les packs de questions
GEMINI_API_KEY=AIza...
# Optionnel : override du modèle (par défaut gemini-2.0-flash, le plus économique)
# GEMINI_MODEL=gemini-2.0-flash
